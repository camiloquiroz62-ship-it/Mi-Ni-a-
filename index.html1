<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Mi Niña Hermosa ❤️</title>
    <!-- Font Awesome para iconos de música y controles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #ffd1dc 0%, #ffe6eb 50%, #e8dff5 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #4a4a4a;
            overflow-x: hidden;
            padding: 20px;
            position: relative;
        }

        /* Contenedor principal */
        .container {
            width: 100%;
            max-width: 480px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 2px solid #ffb6c1;
            border-radius: 25px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(255, 182, 193, 0.4);
            position: relative;
            z-index: 10;
        }

        /* Imagen de Snoopy en el encabezado */
        .snoopy-header {
            width: 130px;
            height: auto;
            margin-bottom: 10px;
            filter: drop-shadow(0px 5px 5px rgba(0,0,0,0.1));
        }

        h1 { color: #d63384; margin-bottom: 5px; font-size: 1.8rem; }
        p.subtitle { color: #6c757d; font-size: 0.95rem; margin-bottom: 20px; }

        /* Reproductor de música destacado */
        .music-player-card {
            background: #fff;
            border: 1px solid #ffccd5;
            border-radius: 15px;
            padding: 12px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }
        .song-info {
            text-align: left;
            font-size: 0.85rem;
        }
        .song-title { font-weight: bold; color: #d63384; }
        .song-artist { color: #6c757d; font-size: 0.8rem; }
        .play-btn {
            background: #d63384;
            color: white;
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s;
        }
        .play-btn:hover { transform: scale(1.1); }

        /* Contador */
        .counter-box {
            background: #fff0f5;
            padding: 15px;
            border-radius: 15px;
            margin-bottom: 25px;
            border: 2px dashed #ff99ac;
        }
        .counter-box h3 { font-size: 0.85rem; color: #d63384; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px; }
        .timer { font-size: 1.15rem; font-weight: bold; color: #4a4a4a; }

        /* Botón de apertura */
        .envelope-btn {
            background: linear-gradient(45deg, #ff758c, #ff7eb3);
            border: none;
            color: white;
            padding: 14px 28px;
            font-size: 1.05rem;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(255, 117, 140, 0.4);
            transition: all 0.3s ease;
            font-weight: bold;
        }
        .envelope-btn:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 8px 20px rgba(255, 117, 140, 0.6);
        }

        /* Carta de amor */
        .letter {
            display: none;
            margin-top: 25px;
            background: #ffffff;
            color: #444;
            padding: 25px 20px;
            border-radius: 20px;
            border: 1px solid #ffe6eb;
            text-align: left;
            line-height: 1.7;
            font-size: 0.95rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            animation: fadeIn 1s ease forwards;
            position: relative;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Sección de Pregunta y Botones al final */
        .question-section {
            display: none;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 2px dashed #ffccd5;
            text-align: center;
        }
        .question-section h4 {
            color: #d63384;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }
        .btn-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            position: relative;
            min-height: 50px;
        }
        .btn-yes {
            background: #28a745;
            color: white;
            border: none;
            padding: 10px 25px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(40, 167, 69, 0.3);
            transition: transform 0.2s;
        }
        .btn-yes:hover { transform: scale(1.1); }
        .btn-no {
            background: #dc3545;
            color: white;
            border: none;
            padding: 10px 25px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            position: absolute;
            box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3);
            transition: all 0.2s ease;
        }

        /* Modal / Mensaje de Aceptación */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            justify-content: center;
            align-items: center;
            z-index: 100;
        }
        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 20px;
            text-align: center;
            max-width: 350px;
            animation: popIn 0.3s ease;
        }
        @keyframes popIn {
            from { transform: scale(0.7); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        /* Elementos Flotantes (Mariposas, Corazones y Snoopy) */
        .floating-item {
            position: fixed;
            top: -10vh;
            font-size: 1.5rem;
            user-select: none;
            pointer-events: none;
            animation: fall linear forwards;
            z-index: 1;
        }
        @keyframes fall {
            to { transform: translateY(105vh) rotate(360deg); }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Snoopy feliz con un corazón -->
        <img src="https://pngimg.com/uploads/snoopy/snoopy_PNG1" alt="Snoopy Feliz" class="snoopy-header">

        <h1>✨ 6 Meses Juntos ✨</h1>
        <p class="subtitle">Una dedicatoria especial para ti</p>

        <!-- Tarjeta del reproductor -->
        <div class="music-player-card">
            <div class="song-info">
                <div class="song-title">Desde Que Te Tengo 🎵</div>
                <div class="song-artist">Carín León</div>
            </div>
            <button class="play-btn" id="musicToggle" onclick="toggleMusic()">
                <i class="fa-solid fa-play" id="musicIcon"></i>
            </button>
        </div>

        <!-- Contador exacto -->
        <div class="counter-box">
            <h3>Tiempo construyendo nuestra historia</h3>
            <div class="timer" id="timer">Cargando tiempo...</div>
        </div>

        <!-- Botón para abrir la carta -->
        <button class="envelope-btn" onclick="openLetter()">Presiona para abrir tu carta 💌</button>

        <!-- Carta de Amor -->
        <div class="letter" id="letter">
            <p style="color: #d63384; font-size: 1.15rem; font-weight: bold; margin-bottom: 10px;">Mi niña hermosa,</p>
            <p>Parece increíble que ya hayan pasado 6 meses desde que inició esta aventura.</p><br>
            <p>Hoy quiero darte las gracias con todo mi corazón por cada uno de los momentos que hemos compartido. Gracias por los días llenos de risas, locuras e incluso esos días malos que hemos tenido. Pasarlos a tu lado me demostró que sin importar lo que venga o los obstáculos que se nos presenten, siempre te volvería a elegir y te seguiré amando cada día más.</p><br>
            <p>Llegaste a mi vida para transformarla por completo. Te has convertido en lo mejor que me ha pasado y no hay día en el que no me saques una sonrisa con tus ocurrencias y tus loqueras. Tu forma de ser llena mis días de una alegría que no cambio por nada.</p><br>
            <p>Quiero que nunca olvides que en mí no solo tienes a tu novio, sino también a tu mayor apoyo. Siempre voy a estar a tu lado respaldando cada uno de tus sueños y metas. Cuando sientas que las cosas se ponen difíciles o pienses que no puedes más, recuerda que ahí estaré yo para sostenerte, escucharte y recordarte lo increíble y fuerte que eres.</p><br>
            <p>Te amo mucho con demasiado, mucho más de lo que las palabras pueden expresar. Gracias por estos seis meses tan maravillosos. Estoy feliz de lo que somos y de todo lo hermoso que nos queda por vivir juntos.</p>

            <!-- Sección de la Pregunta al final de la Carta -->
            <div class="question-section" id="questionSection">
                <h4>¿Aceptas seguir construyendo esta hermosa historia juntos? 💖</h4>
                <div class="btn-group">
                    <button class="btn-yes" onclick="acceptLove()">¡SÍ, ACEPTO! 🥰</button>
                    <button class="btn-no" id="btnNo" onmouseover="moveNoButton()" onclick="moveNoButton()">No 😜</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmación al presionar SÍ -->
    <div class="modal" id="modal">
        <div class="modal-content">
            <img src="https://pngimg.com/uploads/snoopy/snoopy_PNG52.png" style="width: 100px; margin-bottom: 10px;" alt="Snoopy abrazo">
            <h2 style="color: #d63384; margin-bottom: 10px;">¡Sabía que dirías que sí! ❤️</h2>
            <p style="color: #555; font-size: 0.95rem; margin-bottom: 20px;">Prometo hacerte sonreír cada día y seguir amándote con todo mi corazón. ¡Eres lo mejor de mi vida!</p>
            <button class="btn-yes" onclick="closeModal()">Te Amo Muchísimo ✨</button>
        </div>
    </div>

    <!-- Canción de Carín León conectada a tu archivo MP3 -->
    <audio id="bg-music" loop>
        <source src="musica.mp3" type="audio/mpeg">
    </audio>

    <!-- Canvas para efectos de Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>

    <script>
        // Fecha exacta de inicio: 17 de Marzo de 2026
        const startDate = new Date("2026-03-17T00:00:00"); 

        function updateTimer() {
            const now = new Date();
            const diff = now - startDate;

            if (diff < 0) {
                document.getElementById("timer").innerHTML = "¡Casi llega nuestro día!";
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const minutes = Math.floor((diff / (1000 * 60)) % 60);
            const seconds = Math.floor((diff / 1000) % 60);

            document.getElementById("timer").innerHTML = 
                `${days} días, ${hours}h ${minutes}m ${seconds}s`;
        }
        setInterval(updateTimer, 1000);
        updateTimer();

        // Control de Audio
        const music = document.getElementById("bg-music");
        const musicIcon = document.getElementById("musicIcon");

        function toggleMusic() {
            if (music.paused) {
                music.play();
                musicIcon.className = "fa-solid fa-pause";
            } else {
                music.pause();
                musicIcon.className = "fa-solid fa-play";
            }
        }

        // Abrir la carta
        function openLetter() {
            document.getElementById("letter").style.display = "block";
            document.getElementById("questionSection").style.display = "block";
            
            // Iniciar música si está pausada
            if (music.paused) {
                music.play();
                musicIcon.className = "fa-solid fa-pause";
            }

            // Iniciar lluvia de mariposas, corazones y Snoopys
            setInterval(createFloatingItem, 400);

            // Posicionar inicialmente el botón NO al lado del botón SÍ
            const btnNo = document.getElementById("btnNo");
            btnNo.style.left = "180px";
        }

        // Mover el botón "No" cuando intenta tocarlo
        function moveNoButton() {
            const btnNo = document.getElementById("btnNo");
            const x = Math.random() * (window.innerWidth - 120);
            const y = Math.random() * (window.innerHeight - 60);
            
            btnNo.style.position = "fixed";
            btnNo.style.left = x + "px";
            btnNo.style.top = y + "px";
        }

        // Acción al hacer clic en ¡SÍ, ACEPTO!
        function acceptLove() {
            document.getElementById("modal").style.display = "flex";
            
            // Lanzar Confetti
            confetti({
                particleCount: 120,
                spread: 70,
                origin: { y: 0.6 }
            });
        }

        function closeModal() {
            document.getElementById("modal").style.display = "none";
        }

        // Generar mariposas, corazones y Snoopy cayendo del cielo
        function createFloatingItem() {
            const item = document.createElement("div");
            item.classList.add("floating-item");
            
            const items = ["🦋", "❤️", "🌸", "✨", "🐾", "💖", "🦋"];
            item.innerText = items[Math.floor(Math.random() * items.length)];
            
            item.style.left = Math.random() * 100 + "vw";
            item.style.animationDuration = Math.random() * 3 + 3 + "s";
            document.body.appendChild(item);

            setTimeout(() => { item.remove(); }, 6000);
        }
    </script>
</body>
</html>